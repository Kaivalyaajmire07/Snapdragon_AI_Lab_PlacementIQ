# PostgreSQL
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_PORT=5432

# Auth
AUTH_SECRET=change-this-to-a-long-random-secret
FACULTY_USERNAME=faculty
FACULTY_PASSWORD=faculty123
STUDENT_USERNAME=student1
STUDENT_PASSWORD=student123

# Gemini is optional in this Snapdragon build
GEMINI_API_KEY_AI=
GEMINI_API_KEY_DATA=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.6-flash

# Local AI
LOCAL_AI_ENABLED=true
LOCAL_AI_URL=http://127.0.0.1:11434/api/chat
LOCAL_AI_MODEL=qwen2.5:3b

# Model artifacts
MODEL_PATH=backend/trained_models/placement_model_sem6.pkl
KMEANS_MODEL_PATH=backend/trained_models/kmeans_model.pkl
KMEANS_SCALER_PATH=backend/trained_models/kmeans_scaler.pkl
CLUSTER_LABEL_PATH=backend/trained_models/cluster_labels.pkl
